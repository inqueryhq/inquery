# ============================================
# Inquery Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=inquery
POSTGRES_USER=inquery
# Required. No default - the stack refuses to start without it.
POSTGRES_PASSWORD=

# --- Backend (Spring Boot) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=inquery
DB_USERNAME=inquery
# Only needed when running the backend outside Docker Compose.
# Compose passes POSTGRES_PASSWORD through to the backend automatically.
DB_PASSWORD=
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=*

# --- Exposed Port ---
# The port you access Inquery on (http://localhost:80)
APP_PORT=80
